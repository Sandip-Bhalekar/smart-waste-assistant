# Copy this file to .env and fill in values only if you want cloud features.
# The Streamlit app runs fully locally without these credentials.

# Optional image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smart-waste-assistant
STORE_IMAGES=false

# Optional remote database. Leave empty to use local SQLite.
DATABASE_URL=

# Inference
MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
MAX_UPLOAD_MB=8
